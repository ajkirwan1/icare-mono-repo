                      { "value": "bookings", "label": "Bookings only" },
                      { "value": "safeguarding", "label": "Safeguarding only" }
                    ],
                    "default": "all"
                  },
                  "tokens": {
                    "marginBottom": "{spacing.4}"
                  }
                },
                {
                  "component": "activity-feed",
                  "props": {
                    "items": [
                      {
                        "timestamp": "Today, 14:32",
                        "actor": "Admin Sarah",
                        "action": "approved caregiver verification:",
                        "subject": "John Smith (#4523)",
                        "subjectUrl": "/admin/users/4523"
                      },
                      {
                        "timestamp": "Today, 14:15",
                        "actor": null,
                        "action": "Booking #7821 completed successfully",
                        "subject": "(Jane D. → Mary K.)",
                        "subjectUrl": "/admin/bookings/7821"
                      },
                      {
                        "timestamp": "Today, 13:47",
                        "actor": "Admin Sarah",
                        "action": "rejected caregiver verification:",
                        "subject": "David Jones (#4522) - ID expired",
                        "subjectUrl": "/admin/users/4522"
                      },
                      {
