                      },
                      {
                        "timestamp": "Today, 11:23",
                        "actor": "Admin Sarah",
                        "action": "resolved dispute on Booking #7789",
                        "subject": "- Partial refund (50%)",
                        "subjectUrl": "/admin/bookings/7789"
                      }
                    ],
                    "maxVisible": 10
                  },
                  "layout": "vertical-list",
                  "gap": "{spacing.2}"
                }
              ]
            }
          ]
        },
        {
