  "responsiveBehavior": {
    "desktop": {
      "breakpoint": "1440px+",
      "mainLayout": "two-column-70-30",
      "leftColumn": "verification-queue + safeguarding + recent-activity",
      "rightColumn": "quick-actions + platform-health"
    },
    "tablet": {
      "breakpoint": "768px-1439px",
      "mainLayout": "single-column",
      "order": "verification → safeguarding → platform-health-user-activity-side-by-side → recent-activity"
    },
    "mobile": {
      "breakpoint": "320px-767px",
      "mainLayout": "stacked",
      "contentCondensed": true,
      "recentActivityMaxItems": 3
    }
  },
  "stateVariations": {
    "default-normal-operations": {
      "sections": {
        "section-urgent-alert-banner": { "visible": false },
        "widget-verification-queue": { "state": "populated", "slaBreaches": 3 },
        "widget-safeguarding-reports": { "state": "populated", "urgentCount": 1 },
        "widget-recent-activity": { "state": "populated", "items": 10 },
        "widget-platform-health": { "state": "all-operational" }
      }
    },
    "alert-safeguarding-urgent": {
      "sections": {
        "section-urgent-alert-banner": { "visible": true, "variant": "safeguarding-urgent" },
        "widget-verification-queue": { "state": "populated" },
        "widget-safeguarding-reports": { "state": "populated", "urgentCount": 1, "highlighted": true },
        "widget-recent-activity": { "state": "populated" },
        "widget-platform-health": { "state": "all-operational" }
      }
    },
    "alert-sla-breach": {
      "sections": {
        "section-urgent-alert-banner": { "visible": true, "variant": "sla-breach" },
        "widget-verification-queue": { "state": "populated", "slaBreaches": 3, "slaHighlighted": true },
        "widget-safeguarding-reports": { "state": "populated" },
        "widget-recent-activity": { "state": "populated" },
        "widget-platform-health": { "state": "all-operational" }
      }
    },
    "empty-queue-all-clear": {
      "sections": {
        "section-urgent-alert-banner": { "visible": false },
        "widget-verification-queue": { "state": "empty" },
        "widget-safeguarding-reports": { "state": "empty" },
        "widget-recent-activity": { "state": "populated" },
        "widget-platform-health": { "state": "all-operational" }
      }
    }
  },
