{
  "_metadata": {
    "screenId": "scr-adm-001",
    "screenName": "Admin Dashboard",
    "wireframeSource": "adm-dashboard-scr-adm-001.md",
    "generatedDate": "2026-02-10",
    "role": "admin",
    "breakpoints": {
      "desktop": 1440,
      "tablet": 768,
      "mobile": 375
    },
    "states": [
      "default-normal-operations",
      "alert-safeguarding-urgent",
      "alert-sla-breach",
      "empty-queue-all-clear"
    ]
  },
  "frame": {
    "width": 1440,
    "height": "auto",
    "fill": "{colors.background.base}",
    "padding": { "top": 0, "right": 0, "bottom": 0, "left": 0 }
  },
  "sections": [
    {
      "id": "section-admin-header",
      "name": "Admin Navigation Header",
      "order": 1,
      "component": "navigation-header",
      "variant": "admin",
      "props": {
        "role": "admin",
        "userName": "Admin Sarah",
        "userRole": "Operations Manager",
        "notificationCount": "3",
        "hasSearch": true,
        "searchPlaceholder": "Search users, bookings, verifications..."
      },
      "position": { "x": 0, "y": 0 },
      "size": { "width": "fill", "height": "64px" },
      "accessibility": {
        "role": "banner",
        "skipLinkTarget": "main-content"
      }
    },
    {
      "id": "section-urgent-alert-banner",
      "name": "Urgent Alert Banner",
      "order": 2,
      "component": "alert-banner",
      "variant": "safeguarding-urgent",
      "conditional": "urgentAlerts.length > 0",
      "position": { "x": 0, "y": 64 },
      "size": { "width": "100%", "height": "auto" },
      "states": [
        {
          "name": "safeguarding-urgent",
          "condition": "urgentAlerts.type === 'safeguarding'",
          "props": {
            "variant": "error",
            "icon": "alert-circle-red",
            "title": "URGENT SAFEGUARDING REPORT",
            "message": "Report #SR-00423 submitted 35 minutes ago requires immediate review",
            "ctaLabel": "Review Report Now",
            "ctaUrl": "/admin/safeguarding/SR-00423",
            "dismissible": true,
            "tokens": {
              "background": "{colors.alert.error-bg}",
              "border": "4px solid {colors.alert.error-border}",
              "borderSide": "left"
            }
          }
        },
        {
          "name": "sla-breach",
          "condition": "urgentAlerts.type === 'sla-breach'",
          "props": {
            "variant": "warning",
            "icon": "clock-yellow",
            "title": "SLA BREACH ALERT",
            "message": "3 caregiver verifications pending >48 hours",
            "ctaLabel": "Review Queue",
            "ctaUrl": "/admin/verifications",
            "dismissible": true,
            "tokens": {
              "background": "{colors.alert.warning-bg}",
              "border": "4px solid {colors.alert.warning-border}",
              "borderSide": "left"
            }
          }
        }
      ]
    },
    {
      "id": "section-main-content",
      "name": "Main Content Area",
      "order": 3,
      "layout": "two-column",
      "columnRatio": "70-30",
      "gap": "clamp(26px, 3.4vw, 52px)",
      "padding": { "horizontal": "{spacing.6}", "vertical": "{spacing.6}" },
      "position": { "x": 0, "y": "auto" },
      "size": { "width": "100%", "height": "auto" },
      "responsive": {
        "tablet": { "layout": "single-column" },
        "mobile": { "layout": "stacked" }
      },
      "children": [
        {
          "id": "main-column-left",
          "name": "Left Column (Primary Widgets)",
          "layout": "vertical",
          "gap": "{spacing.6}",
          "size": { "width": "70%", "height": "auto" },
          "responsive": {
            "tablet": { "width": "100%" },
            "mobile": { "width": "100%" }
          },
          "children": [
            {
              "id": "widget-verification-queue",
              "component": "widget-container",
              "variant": "with-header-action",
              "props": {
                "title": "Verification Queue",
                "subtitle": "Caregivers awaiting admin review",
                "hasHeaderAction": true,
                "headerActionLabel": "View Queue",
                "headerActionUrl": "/admin/verifications"
              },
              "states": [
                {
                  "name": "populated",
                  "condition": "verificationQueue.totalPending > 0",
                  "children": [
                    {
                      "component": "metric-list",
                      "layout": "vertical",
                      "gap": "{spacing.3}",
                      "children": [
                        {
                          "component": "metric-row",
                          "props": {
                            "label": "Pending Verifications",
                            "value": "12 caregivers",
                            "linkUrl": "/admin/verifications"
                          }
                        },
                        {
                          "component": "metric-breakdown",
                          "layout": "horizontal",
                          "gap": "{spacing.4}",
                          "children": [
                            {
                              "component": "metric-item",
                              "props": { "label": "Identity", "value": "8 pending" }
                            },
                            {
                              "component": "metric-item",
                              "props": { "label": "Right to Work", "value": "4 pending" }
                            },
                            {
                              "component": "metric-item",
                              "props": { "label": "DBS (Voluntary)", "value": "3 pending" }
                            }
                          ]
                        },
                        {
                          "component": "sla-indicator",
                          "props": {
                            "icon": "warning-triangle-red",
                            "text": "3 over 48h SLA",
                            "status": "breached"
                          },
                          "tokens": {
                            "fill": "{colors.semantic.error}",
                            "fontWeight": "{fontWeights.bold}"
                          }
                        },
                        {
                          "component": "metric-row",
                          "props": {
                            "label": "Average Wait Time",
                            "value": "18 hours",
                            "statusLabel": "On Track",
                            "statusColor": "green"
                          }
                        }
                      ]
                    },
                    {
                      "component": "button",
                      "variant": "primary",
                      "props": {
                        "label": "Review Queue",
                        "url": "/admin/verifications"
                      },
                      "tokens": {
                        "marginTop": "{spacing.4}"
                      }
                    }
                  ]
                },
                {
                  "name": "empty",
                  "condition": "verificationQueue.totalPending === 0",
                  "children": [
                    {
                      "component": "empty-state",
                      "variant": "success",
                      "props": {
                        "icon": "checkmark-green",
                        "heading": "All Clear! No pending verifications.",
                        "message": "Last verification reviewed: 2 hours ago by Admin Sarah",
                        "hasAction": true,
                        "ctaLabel": "View Queue",
                        "ctaVariant": "secondary",
                        "ctaUrl": "/admin/verifications"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "widget-safeguarding-reports",
              "component": "widget-container",
              "variant": "with-header-action",
              "props": {
                "title": "Safeguarding Reports",
                "subtitle": "Active safety concerns requiring attention",
                "hasHeaderAction": true,
                "headerActionLabel": "View Reports",
                "headerActionUrl": "/admin/safeguarding"
              },
              "states": [
                {
                  "name": "populated",
                  "condition": "safeguardingReports.activeCount > 0",
                  "children": [
                    {
                      "component": "metric-list",
                      "layout": "vertical",
                      "gap": "{spacing.3}",
                      "children": [
                        {
                          "component": "metric-row",
                          "props": {
                            "label": "Active Reports",
                            "value": "2 cases",
                            "linkUrl": "/admin/safeguarding"
                          }
                        },
                        {
                          "component": "urgent-indicator",
                          "props": {
                            "icon": "warning-triangle-red",
                            "label": "Urgent (High Severity)",
                            "value": "1 report",
                            "subtext": "Submitted 35 minutes ago"
                          },
                          "tokens": {
                            "fill": "{colors.semantic.error}",
                            "fontWeight": "{fontWeights.bold}"
                          }
                        },
                        {
                          "component": "activity-timeline",
                          "props": {
                            "title": "Recent Activity (last 7 days)",
                            "items": [
                              { "date": "Feb 6", "text": "Report #SR-00421 resolved (outcome: no action)" },
                              { "date": "Feb 5", "text": "Report #SR-00420 escalated to SAB" },
                              { "date": "Feb 3", "text": "Report #SR-00419 resolved (user suspended)" }
                            ],
                            "viewAllUrl": "/admin/safeguarding/activity"
                          }
                        }
                      ]
                    },
                    {
                      "component": "button",
                      "variant": "primary",
                      "props": {
                        "label": "View Reports",
                        "url": "/admin/safeguarding"
                      },
                      "tokens": {
                        "marginTop": "{spacing.4}"
                      }
                    }
                  ]
                },
                {
                  "name": "empty",
                  "condition": "safeguardingReports.activeCount === 0",
                  "children": [
                    {
                      "component": "empty-state",
                      "variant": "success",
                      "props": {
                        "icon": "checkmark-green",
                        "heading": "No active safeguarding reports",
                        "message": null,
                        "hasAction": true,
                        "ctaLabel": "View Reports",
                        "ctaVariant": "secondary",
                        "ctaUrl": "/admin/safeguarding"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "widget-recent-activity",
              "component": "widget-container",
              "variant": "with-header-action",
              "props": {
                "title": "Recent Activity",
