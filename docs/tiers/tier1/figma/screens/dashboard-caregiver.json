  "accessibilityNotes": {
    "focusOrder": [
      "skip-link",
      "navigation-header",
      "alert-banner",
      "pending-requests-widget",
      "upcoming-bookings-widget",
      "earnings-summary-widget",
      "profile-status-widget",
      "quick-actions-widget",
      "footer"
    ],
    "ariaLiveRegions": [
      {
        "section": "pending-requests",
