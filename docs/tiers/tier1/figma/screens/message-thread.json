  "stateVariations": {
    "active-conversation": {
      "description": "Default state with message history, typing indicator, and input area"
    },
    "empty-state": {
      "description": "First message - no messages yet",
      "replaceSection": "section-messages",
      "elements": [
        { "component": "text", "content": "💬", "tokens": { "fontSize": "48px", "textAlign": "center" } },
        { "component": "text", "variant": "h2", "content": "Start the conversation", "tokens": { "fontSize": "{fontSizes.xl}", "textAlign": "center" } },
        { "component": "text", "content": "Send a message to Mary to get started. Messages are monitored for your safety.", "tokens": { "fontSize": "{fontSizes.base}", "fill": "{colors.text.muted}", "textAlign": "center" } }
      ]
    },
    "contact-redaction": {
      "description": "Message with redacted contact information",
      "additionalElements": [
        { "component": "message-bubble", "variant": "other", "props": { "senderName": "Mary Thompson", "text": "Hi! My number is [REDACTED] - call me anytime.", "time": "Today at 2:30 PM", "redactionAlert": "⚠️ Contact info removed for your safety" } }
      ]
    },
    "blocked": {
      "description": "Conversation blocked by user",
      "replaceSection": "section-message-input",
      "elements": [
        { "component": "alert-banner", "variant": "warning", "props": { "icon": "⚠️", "heading": "This conversation is blocked", "message": "You have blocked this user. You can no longer send or receive messages. Your booking is not affected." } },
        { "component": "button", "variant": "secondary", "props": { "label": "Unblock User" } }
      ]
    },
    "archived": {
      "description": "Conversation archived after 30 days",
      "replaceSection": "section-message-input",
      "elements": [
        { "component": "alert-banner", "variant": "info", "props": { "icon": "ℹ️", "heading": "This conversation is archived", "message": "This booking was completed more than 30 days ago. You can view messages but cannot send new ones." } },
        { "component": "button", "variant": "secondary", "props": { "label": "View Booking Details" } }
      ]
    },
    "sending": {
      "description": "Message being sent",
      "additionalElements": [
        { "component": "message-bubble", "variant": "own", "props": { "text": "Great, see you Wednesday!", "time": "Sending...", "readReceipt": "⏳" } }
      ]
    },
    "failed-to-send": {
      "description": "Message failed to send",
      "additionalElements": [
        { "component": "message-bubble", "variant": "own", "props": { "text": "Great, see you Wednesday!", "time": "⚠️ Failed to send", "readReceipt": "Retry" } }
      ]
    },
    "loading": {
      "description": "Initial page loading state"
    }
  },
  "responsiveBehavior": {
    "desktop": { "breakpoint": "1440px+", "layout": "Two-column conversation header. Message container centered, max-width 900px. Fixed message input at bottom." },
    "tablet": { "breakpoint": "768px-1439px", "layout": "Single column conversation header (stacked). Smaller participant photo (60px). Full-width messages." },
    "mobile": { "breakpoint": "320px-767px", "layout": "Compact: Back button top-left. Participant card 40px photo. Booking context collapsible. Fixed message input at bottom. Contact warning condensed." }
  },
  "accessibilityNotes": {
