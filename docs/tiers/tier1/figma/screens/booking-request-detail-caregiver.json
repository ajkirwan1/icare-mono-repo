{
  "_metadata": {
    "screenId": "SCR-CG-013",
    "screenName": "Booking Request Detail (Caregiver)",
    "wireframeSource": "/docs/tiers/tier1/draft-design-specs/wireframes/booking/scr-cg-013-booking-request-detail.md",
    "generatedDate": "2026-02-11",
    "role": "caregiver",
    "route": "/bookings/:bookingId",
    "breakpoints": {
      "desktop": 1440,
      "tablet": 768,
      "mobile": 375
    },
    "states": [
      "pending",
      "accepted",
      "in_progress",
      "completed",
      "payment_released",
      "declined",
      "expired"
    ],
    "description": "Caregiver view of booking request detail. Shows earnings breakdown, accept/decline actions, privacy-limited care receiver info before acceptance, and mark complete functionality."
  },
  "frame": {
    "width": 1440,
    "height": "auto",
    "fill": "{colors.background.base}",
    "padding": { "top": 0, "right": 0, "bottom": 0, "left": 0 }
  },
  "sections": [
    {
      "id": "section-header",
      "name": "Navigation Header",
      "order": 1,
      "component": "navigation-header",
      "variant": "caregiver",
      "props": {
        "role": "caregiver",
        "userName": "Sarah Thompson",
        "notificationCount": "1",
        "hasSearch": false
      },
      "position": { "x": 0, "y": 0 },
      "size": { "width": "fill", "height": "64px" },
      "accessibility": {
        "role": "banner",
        "skipLinkTarget": "main-content"
      }
    },
    {
      "id": "section-breadcrumb",
      "name": "Breadcrumb Navigation",
      "order": 2,
      "component": "breadcrumb",
      "position": { "x": 0, "y": 64 },
      "size": { "width": "100%", "height": "auto" },
      "padding": {
        "horizontal": "{spacing.6}",
        "vertical": "{spacing.4}"
      },
      "props": {
        "items": [
          { "label": "Dashboard", "url": "/dashboard", "active": false },
          { "label": "My Bookings", "url": "/bookings", "active": false },
          { "label": "Booking Request", "url": "/bookings/${booking.id}", "active": true }
        ]
      },
      "accessibility": {
        "ariaLabel": "Breadcrumb navigation"
      }
    },
    {
      "id": "section-page-title",
      "name": "Page Title with Status and Timer",
      "order": 3,
      "layout": "horizontal",
      "alignItems": "center",
      "justifyContent": "space-between",
      "gap": "{spacing.4}",
      "padding": {
        "horizontal": "{spacing.6}",
        "vertical": "{spacing.4}"
      },
      "position": { "x": 0, "y": "auto" },
      "size": { "width": "100%", "height": "auto" },
      "children": [
        {
          "component": "text",
          "variant": "h1",
          "content": "Booking Request from ${careReceiver.firstName}",
          "tokens": {
            "fontSize": "{fontSizes.2xl}",
            "fontWeight": "{fontWeights.bold}",
            "fill": "{colors.text.primary}"
          }
        },
        {
          "component": "frame",
          "layout": "horizontal",
          "gap": "{spacing.3}",
          "alignItems": "center",
          "children": [
            {
              "component": "status-badge",
              "variant": "${statusVariant}",
              "props": {
                "status": "${booking.status}",
                "size": "large"
              },
              "accessibility": {
                "role": "status",
                "ariaLabel": "Booking status: ${booking.statusLabel}"
              }
            },
            {
              "component": "countdown-timer",
              "variant": "${timerVariant}",
              "visible": "${showCountdownTimer}",
              "props": {
                "deadline": "${booking.responseDeadline || booking.confirmationDeadline}",
                "format": "hours-minutes",
                "urgentThreshold": "2h"
              },
              "accessibility": {
                "role": "timer",
                "ariaLive": "polite",
                "ariaAtomic": true
              }
            }
          ]
        }
      ]
    },
    {
      "id": "section-alert-banner",
      "name": "State-Dependent Alert Banner",
      "order": 4,
      "component": "alert-banner",
      "variant": "${alertVariant}",
      "visible": "${showAlertBanner}",
      "position": { "x": 0, "y": "auto" },
      "size": { "width": "100%", "height": "auto" },
      "padding": {
        "horizontal": "{spacing.6}",
        "vertical": "{spacing.4}"
      },
      "props": {
        "icon": "${alertIcon}",
        "heading": "${alertHeading}",
        "message": "${alertMessage}",
        "actions": "${alertActions}"
      },
      "accessibility": {
        "role": "alert",
        "ariaLive": "polite"
      }
    },
    {
      "id": "section-content-area",
      "name": "Content Area (Two-Column Layout)",
      "order": 5,
      "layout": "two-column",
      "position": { "x": 0, "y": "auto" },
      "size": { "width": "100%", "height": "auto" },
      "padding": {
        "horizontal": "{spacing.6}",
        "vertical": "{spacing.6}"
      },
      "gap": "{spacing.8}",
      "columnSizes": {
        "desktop": ["65%", "35%"],
        "tablet": ["100%"],
        "mobile": ["100%"]
      },
      "children": [
        {
          "id": "main-column",
          "name": "Main Column (Left)",
          "layout": "vertical",
          "gap": "{spacing.6}",
          "children": [
            {
              "id": "care-receiver-info-card",
              "name": "Care Receiver Information Card",
              "component": "care-receiver-card",
              "variant": "${privacyVariant}",
              "props": {
                "careReceiver": "${careReceiver}",
                "variant": "${privacyVariant}",
                "showFullDetails": "${showContactDetails}"
              },
              "tokens": {
                "fill": "{colors.background.card-glass}",
                "borderRadius": "{borderRadius.lg}",
                "boxShadow": "{boxShadow.card-soft}",
                "padding": "{spacing.6}"
              },
              "accessibility": {
                "ariaLabel": "Care receiver information"
              }
            },
            {
              "id": "booking-detail-card",
              "name": "Booking Details Card",
              "component": "booking-detail-card",
              "props": {
                "booking": "${booking}",
                "showEmergencyContact": false
              },
              "tokens": {
                "fill": "{colors.background.card-glass}",
                "borderRadius": "{borderRadius.lg}",
                "boxShadow": "{boxShadow.card-soft}",
                "padding": "{spacing.6}"
              }
            },
            {
              "id": "booking-timeline",
              "name": "Booking History Timeline",
              "component": "booking-timeline",
              "visible": "${showTimeline}",
              "props": {
                "events": "${booking.timeline}",
                "currentStatus": "${booking.status}"
              },
              "tokens": {
                "fill": "{colors.background.card-glass}",
                "borderRadius": "{borderRadius.lg}",
                "boxShadow": "{boxShadow.card-soft}",
                "padding": "{spacing.6}"
              },
              "accessibility": {
                "role": "list",
                "ariaLabel": "Booking status history"
              }
            }
          ]
        },
        {
          "id": "sidebar-column",
          "name": "Sidebar Column (Right)",
          "layout": "vertical",
          "gap": "{spacing.6}",
          "children": [
            {
              "id": "earnings-breakdown-card",
              "name": "Earnings Breakdown",
              "component": "earnings-breakdown-card",
              "props": {
                "earnings": "${earnings}",
                "status": "${booking.status}"
              },
              "tokens": {
                "fill": "{colors.background.card-glass}",
                "borderRadius": "{borderRadius.lg}",
                "boxShadow": "{boxShadow.card-soft}",
                "padding": "{spacing.6}"
              }
            },
            {
              "id": "emergency-contact-card",
              "name": "Emergency Contact (In Progress)",
              "component": "frame",
              "visible": "${showEmergencyContactCard}",
              "tokens": {
                "fill": "{colors.alert.error-bg}",
                "border": "2px solid {colors.alert.error-border}",
                "borderRadius": "{borderRadius.lg}",
                "padding": "{spacing.6}"
              },
              "layout": "vertical",
              "gap": "{spacing.4}",
              "children": [
                {
                  "component": "text",
                  "variant": "h2",
                  "content": "🚨 Emergency Contact",
                  "tokens": {
                    "fontSize": "{fontSizes.lg}",
                    "fontWeight": "{fontWeights.bold}",
                    "fill": "{colors.alert.error-text}"
                  }
                },
                {
                  "component": "text",
                  "content": "${emergencyContact.name}",
                  "tokens": {
                    "fontSize": "{fontSizes.base}",
                    "fontWeight": "{fontWeights.semibold}"
                  }
                },
                {
                  "component": "text",
                  "content": "${emergencyContact.relationship}",
                  "tokens": {
                    "fontSize": "{fontSizes.sm}",
                    "fill": "{colors.text.muted}"
                  }
                },
                {
                  "component": "text",
                  "content": "📞 ${emergencyContact.phone}",
                  "tokens": {
                    "fontSize": "{fontSizes.base}",
                    "fontWeight": "{fontWeights.semibold}"
                  }
                },
                {
                  "component": "button",
                  "variant": "destructive",
                  "label": "Call Emergency Contact",
                  "action": "tel:${emergencyContact.phone}",
                  "tokens": {
                    "width": "100%"
                  },
                  "accessibility": {
                    "ariaLabel": "Call emergency contact ${emergencyContact.name}"
                  }
                },
                {
                  "component": "button",
                  "variant": "destructive",
                  "label": "Call 999",
                  "action": "tel:999",
                  "tokens": {
                    "width": "100%"
                  },
                  "accessibility": {
                    "ariaLabel": "Call emergency services 999"
                  }
                }
              ]
            },
            {
              "id": "actions-card",
              "name": "Action Buttons",
              "component": "frame",
              "tokens": {
                "fill": "{colors.background.card-glass}",
                "borderRadius": "{borderRadius.lg}",
                "boxShadow": "{boxShadow.card-soft}",
                "padding": "{spacing.6}"
              },
              "layout": "vertical",
              "gap": "{spacing.3}",
              "children": "${stateActions}"
            }
          ]
        }
      ]
    },
    {
      "id": "section-footer",
      "name": "Footer",
      "order": 6,
      "component": "footer-global",
      "variant": "desktop-full",
      "position": { "x": 0, "y": "auto" },
      "size": { "width": "100%", "height": "auto" },
      "props": {
        "layout": "horizontal",
        "copyrightText": "© 2026 iCare Platform. All rights reserved."
      },
      "responsive": {
        "tablet": { "variant": "tablet-condensed", "layout": "two-line" },
        "mobile": { "variant": "mobile-compact", "layout": "vertical" }
      }
    }
  ],
