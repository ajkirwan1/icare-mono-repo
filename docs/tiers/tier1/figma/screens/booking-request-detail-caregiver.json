      "alertVariant": "info",
      "alertIcon": "⏳",
      "alertHeading": "Respond within 24 hours",
      "alertMessage": "Review this booking request and accept or decline within 24 hours. If you don't respond, the request will be automatically declined.",
      "alertActions": [
        {
          "label": "Accept Booking",
          "variant": "primary",
          "action": "modal:accept-booking-confirmation"
        },
        {
          "label": "Decline Booking",
