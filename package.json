{
  "name": "root",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "dev:db": "cd docker && docker compose -f docker-compose.dev.yml --env-file .env.local up -d",
    "dev:api": "npm run dev:full --prefix packages/ICare/express-api",
    "dev:web": "npm run dev --workspace=packages/ICare",
    "dev": "npm run dev:db && concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "source docker/.env.production && npm run build --workspace=packages/ICare",
    "prod:up": "cd docker && docker compose -f docker-compose.prod.yml --env-file .env.production up -d",
    "prod:down": "cd docker && docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "prod:logs": "cd docker && docker compose -f docker-compose.prod.yml --env-file .env.production logs -f"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lerna": "^8.2.3",
    "lightningcss": "^1.30.2",
    "prettier": "^3.6.2",
    "sass": "^1.97.2",
    "storybook-addon-mock": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.42.0",
    "wait-on": "^9.0.3"
  },
  "lint-staged": {
    "*.tsx": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@portabletext/react": "^6.0.2",
    "@sanity/client": "^7.14.0",
    "@sanity/image-url": "^2.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express-rate-limit": "^8.2.1",
    "pg": "^8.17.1",
    "resend": "^6.8.0",
    "zod": "^4.3.6"
  }
}
