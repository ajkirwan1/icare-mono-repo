icare-app.co.uk {
    # Basic auth - remove this block to make site public
    basicauth * {
        admin REPLACE_WITH_CADDY_HASH_PASSWORD
    }

    # API routes
    handle /api/* {
        reverse_proxy api:4001
    }

    # Everything else goes to web app
    handle {
        reverse_proxy web:3000
    }
}
