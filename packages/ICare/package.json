{
    "name": "icare-app",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "SASS_FORCE_PURE=true react-router build",
        "start": "react-router-serve ./build/server/index.js",
        "typecheck": "react-router typegen && tsc",
        "dev": "SASS_FORCE_PURE=true CHOKIDAR_USEPOLLING=1 react-router dev --host 127.0.0.1",
        "test:contact-protection": "node --test app/utils/contact-protection.test.js",
        "test:intro-video-validation": "node --test app/utils/intro-video-validation.test.js",
        "test:terms-acceptance": "node --test app/utils/terms-acceptance.test.js"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fortawesome/fontawesome-svg-core": "^7.1.0",
        "@fortawesome/free-brands-svg-icons": "^7.1.0",
        "@fortawesome/free-regular-svg-icons": "^7.1.0",
        "@fortawesome/free-solid-svg-icons": "^7.1.0",
        "@fortawesome/react-fontawesome": "^3.1.1",
        "@fullcalendar/core": "^6.1.19",
        "@fullcalendar/daygrid": "^6.1.19",
        "@fullcalendar/list": "^6.1.19",
        "@fullcalendar/react": "^6.1.19",
        "@mui/material": "^6.5.0",
        "@react-router/node": "^7.7.1",
        "@react-router/serve": "^7.7.1",
        "@remix-run/node": "^2.17.1",
        "@stencil/react-output-target": "^1.2.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.22.1",
        "isbot": "^5.1.27",
        "openai": "^6.17.0",
        "react": "^19.1.0",
        "react-circular-progressbar": "^2.2.0",
        "react-dom": "^19.1.0",
        "react-icons": "^5.5.0",
        "react-pdf": "^10.1.0",
        "react-router": "^7.7.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@react-router/dev": "^7.7.1",
        "@tailwindcss/vite": "^4.1.4",
        "@types/node": "^20",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "json-server": "^1.0.0-beta.3",
        "sass": "^1.97.1",
        "sass-embedded": "^1.97.1",
