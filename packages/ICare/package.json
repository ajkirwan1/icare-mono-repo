{
  "name": "icare-app",
  "version": "0.4.2-dev.28",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "dev": "react-router dev",
    "dev:backend": "nodemon app/server/index.js",
    "docker:db": "docker compose up -d db",
    "db:wait": "wait-on tcp:localhost:5432",
    "db:init": "node app/server/scripts/run-sql.js",
    "dev:seed": "run-s docker:db db:wait db:init",
    "dev:all": "run-s dev:seed && run-p dev:backend dev"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@mui/material": "^6.5.0",
    "@react-router/node": "^7.7.1",
    "@react-router/serve": "^7.7.1",
    "@remix-run/node": "^2.17.1",
    "@stencil/react-output-target": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "isbot": "^5.1.27",
    "react": "^19.1.0",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-library": "^0.2.0",
    "react-pdf": "^10.1.0",
    "react-router": "^7.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-router/dev": "^7.7.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "json-server": "^1.0.0-beta.3",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "sass": "^1.97.1",
    "sass-embedded": "^1.97.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "wait-on": "^9.0.3"
  },
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler"
  }
}
